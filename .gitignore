# Secrets — never commit this
.env

# Python
.venv/
__pycache__/
*.pyc

# Piper voices, downloaded on first use. About 63 MB each.
voices/

# Which Pi ./deploy.sh last sent to — local to your machine.
.deploy-target

# Whatever the speaker printed while it was running, and its pidfile.
*.log*
*.pid

# Model caches that get downloaded automatically.
# models/ is NOT ignored — a wake word you trained yourself belongs in the
# project, and it's only about a megabyte.
.cache/

# Training data and intermediates. All of it is either downloaded or
# generated by the scripts in train/, and together it's over 2 GB:
#   train/data/       negative features, room recordings, noise  (963 MB)
#   train/voices/     the Piper voices used to make clips        (1.1 GB)
#   train/hey_claude/ the generated clips and their features     (147 MB)
# Rebuild it with train/fetch_data.py and train/generate_clips.py.
train/data/
train/voices/
train/*/
# ...but keep the stub package the trainer needs to import.
!train/stub/

# Build output of a training run. The copy that matters lives in models/.
train/*.onnx
train/*.tflite

# macOS
.DS_Store
